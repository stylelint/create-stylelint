{
  "name": "create-stylelint",
  "version": "2.0.0",
  "description": "The npm init script for Stylelint.",
  "keywords": [
    "stylelint",
    "npm init"
  ],
  "repository": "stylelint/create-stylelint",
  "funding": [
    {
      "type": "opencollective",
      "url": "https://opencollective.com/stylelint"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/stylelint"
    }
  ],
  "license": "MIT",
  "author": "stylelint",
  "type": "module",
  "exports": "./create-stylelint.mjs",
  "bin": {
    "create-stylelint": "./create-stylelint.mjs"
  },
  "files": [
    "create-stylelint.mjs",
    "src"
  ],
  "scripts": {
    "format": "prettier . --write --cache",
    "lint": "run-p --continue-on-error lint:*",
    "lint:formatting": "prettier . --check --cache",
    "lint:js": "eslint",
    "lint:md": "remark . --quiet --frail",
    "lint:packagejson": "npmPkgJsonLint .",
    "lint:types": "tsc",
    "pretest": "npm run lint",
    "test": "node --test test/integration.test.js",
    "watch": "node --test --watch test/integration.test.js"
  },
  "prettier": "@stylelint/prettier-config",
  "npmpackagejsonlint": {
    "extends": "@stylelint/npm-package-json-lint-config"
  },
  "remarkConfig": {
    "plugins": [
      "@stylelint/remark-preset"
    ]
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "cosmiconfig": "^10.0.1",
    "semver": "^7.8.5",
    "tinyexec": "^1.3.1"
  },
  "devDependencies": {
    "@stylelint/npm-package-json-lint-config": "^7.0.0",
    "@stylelint/prettier-config": "^4.1.0",
    "@stylelint/remark-preset": "^5.1.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-stylelint": "^28.0.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "remark-cli": "^12.0.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
