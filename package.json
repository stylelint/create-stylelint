{
  "name": "create-stylelint",
  "version": "1.0.1",
  "description": "The npm init script for Stylelint.",
  "keywords": [
    "stylelint",
    "npm init"
  ],
  "repository": "stylelint/create-stylelint",
  "funding": [
    {
      "type": "opencollective",
      "url": "https://opencollective.com/stylelint"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/stylelint"
    }
  ],
  "license": "MIT",
  "author": "stylelint",
  "type": "module",
  "exports": "./create-stylelint.mjs",
  "bin": {
    "create-stylelint": "./create-stylelint.mjs"
  },
  "files": [
    "create-stylelint.mjs",
    "src"
  ],
  "scripts": {
    "format": "prettier . --write --cache",
    "lint": "run-p --continue-on-error lint:*",
    "lint:formatting": "prettier . --check --cache",
    "lint:js": "eslint",
    "lint:md": "remark . --quiet --frail",
    "lint:packagejson": "npmPkgJsonLint .",
    "lint:types": "tsc",
    "pretest": "npm run lint",
    "test": "node --test test/integration.test.js",
    "watch": "node --test --watch test/integration.test.js"
  },
  "prettier": "@stylelint/prettier-config",
  "npmpackagejsonlint": {
    "extends": "@stylelint/npm-package-json-lint-config"
  },
  "remarkConfig": {
    "plugins": [
      "@stylelint/remark-preset"
    ]
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "cosmiconfig": "^9.0.2",
    "semver": "^7.8.5",
    "tinyexec": "^1.2.4"
  },
  "devDependencies": {
    "@stylelint/npm-package-json-lint-config": "^6.0.0",
    "@stylelint/prettier-config": "^4.0.0",
    "@stylelint/remark-preset": "^5.1.1",
    "@types/node": "^26.0.1",
    "eslint": "^10.5.0",
    "eslint-config-stylelint": "^27.0.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.8.4",
    "remark-cli": "^12.0.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
